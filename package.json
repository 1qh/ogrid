{
  "name": "ogrid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "readonly/*"
  ],
  "scripts": {
    "build": "turbo build",
    "check": "lintmax check",
    "clean": "sh clean.sh",
    "dev": "turbo dev",
    "fix": "turbo build && lintmax fix",
    "prepare": "bunx simple-git-hooks",
    "test": "turbo test"
  },
  "simple-git-hooks": {
    "pre-commit": "sh up.sh && git add -u"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lintmax": "latest",
    "turbo": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.3.11",
  "trustedDependencies": [
    "esbuild",
    "lintmax",
    "msw",
    "sharp"
  ]
}

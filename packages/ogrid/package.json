{
  "name": "ogrid",
  "version": "0.0.7",
  "description": "A content-aware dashboard grid for React. Zero config. Full control.",
  "keywords": [
    "react",
    "grid",
    "dashboard",
    "drag",
    "resize",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1qh/ogrid"
  },
  "license": "MIT",
  "author": "1qh",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "bun run build",
    "postpublish": "bunx pm4ai@latest cleanup",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "latest",
    "react-grid-layout": "latest",
    "tailwind-merge": "latest"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  }
}
